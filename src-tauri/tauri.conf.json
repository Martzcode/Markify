{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Markify",
  "version": "0.1.0",
  "identifier": "com.markify.app",
  "build": {
    "frontendDist": "../dist/markify",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start"
  },
  "app": {
    "windows": [
      {
        "title": "Markify",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {}
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
